generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String            @id @default(uuid())
  name         String
  email        String            @unique
  password     String
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  role         Role              @default(CUSTOMER)
  applications LoanApplication[]
}

model LoanApplication {
  id             String              @id @default(uuid())
  applicationId  String              @unique
  loanType       String
  fullName       String
  email          String
  phone          String
  pan            String
  aadhaar        String
  address        String?
  city           String?
  state          String?
  employmentType String?
  companyName    String?
  monthlyIncome  Float?
  loanAmount     Float
  tenure         Int
  interestRate   Float
  verified       Boolean             @default(false)
  creditScore    Int?
  riskScore      Int?
  approvalStatus String              @default("PENDING")
  status         String              @default("SUBMITTED")
  signature      String?
  adminRemark    String?
  userId         String
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  documents      Document[]
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  history        LoanStatusHistory[]
}

model Document {
  id            String          @id @default(uuid())
  applicationId String
  documentType  String
  fileName      String
  fileUrl       String
  status        String          @default("PENDING")
  uploadedAt    DateTime        @default(now())
  application   LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model LoanStatusHistory {
  id            String          @id @default(uuid())
  applicationId String
  status        String
  remark        String?
  createdAt     DateTime        @default(now())
  application   LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

enum Role {
  CUSTOMER
  ADMIN
  LOAN_MANAGER
}
